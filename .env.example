# Replace with your LaunchDarkly Server-Side SDK Key (found in Project Settings -> Environments)
LD_SDK_KEY="your-server-side-sdk-key-here"

# Replace with your LaunchDarkly Client-Side ID (found in Project Settings -> Environments)
LD_CLIENT_ID="your-client-side-id-here"

# (Optional) LaunchDarkly Generic Webhook Flag Trigger URL for automated remediation
LD_TRIGGER_URL="https://app.launchdarkly.com/api/v2/flags/default/enable-typing-indicator/triggers/your-trigger-id"

# (Optional) OpenAI API Key. If omitted, the app runs an intelligent persona simulator that responds based on the LD prompt/model variation with zero API costs.
OPENAI_API_KEY="your-optional-openai-api-key"

